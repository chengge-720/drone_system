<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--主键字段映射-->
<mapper namespace="com.drone.system.mapper.UavTaskMapper">
    <resultMap id="UavTaskResult" type="UavTask">
        <!--主键值映射-->
        <id property="taskId" column="task_id"/>
        <!--普通字段映射-->
        <result property="taskName" column="task_name"/>
        <result property="taskType" column="task_type"/>
        <result property="startLocation" column="start_location"/>
        <result property="endLocation" column="end_location"/>
        <result property="description" column="description"/>
        <result property="uavId" column="uav_id"/>
        <result property="uavModel" column="uav_model"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>
    
    <sql id="selectUavTaskVo">
        select task_id, task_name, task_type, start_location, end_location, description, 
               uav_id, uav_model, status, create_time, update_time 
        from uav_task_info
    </sql>
    
    <select id="selectUavTaskList" parameterType="UavTask" resultMap="UavTaskResult">
        <include refid="selectUavTaskVo"/>
        <where>
            <if test="taskName != null and taskName != ''">
                AND task_name like concat('%', #{taskName}, '%')
            </if>
            <if test="taskType != null and taskType != ''">
                AND task_type = #{taskType}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="uavId != null">
                AND uav_id = #{uavId}
            </if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectUavTaskByTaskId" parameterType="Integer" resultMap="UavTaskResult">
        <include refid="selectUavTaskVo"/>
        where task_id = #{taskId}
    </select>
    
    <select id="selectUavTaskByUavId" parameterType="Integer" resultMap="UavTaskResult">
        <include refid="selectUavTaskVo"/>
        where uav_id = #{uavId}
        order by create_time desc
    </select>
    
    <insert id="insertUavTask" parameterType="UavTask" useGeneratedKeys="true" keyProperty="taskId">
        insert into uav_task_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">task_name,</if>
            <if test="taskType != null and taskType != ''">task_type,</if>
            <if test="startLocation != null and startLocation != ''">start_location,</if>
            <if test="endLocation != null and endLocation != ''">end_location,</if>
            <if test="description != null and description != ''">description,</if>
            <if test="uavId != null">uav_id,</if>
            <if test="uavModel != null and uavModel != ''">uav_model,</if>
            <if test="status != null">status,</if>
            create_time, update_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">#{taskName},</if>
            <if test="taskType != null and taskType != ''">#{taskType},</if>
            <if test="startLocation != null and startLocation != ''">#{startLocation},</if>
            <if test="endLocation != null and endLocation != ''">#{endLocation},</if>
            <if test="description != null and description != ''">#{description},</if>
            <if test="uavId != null">#{uavId},</if>
            <if test="uavModel != null and uavModel != ''">#{uavModel},</if>
            <if test="status != null">#{status},</if>
            sysdate(), sysdate()
        </trim>
    </insert>
    
    <update id="updateUavTask" parameterType="UavTask">
        update uav_task_info
        <set>
            <if test="taskName != null and taskName != ''">task_name = #{taskName},</if>
            <if test="taskType != null and taskType != ''">task_type = #{taskType},</if>
            <if test="startLocation != null and startLocation != ''">start_location = #{startLocation},</if>
            <if test="endLocation != null and endLocation != ''">end_location = #{endLocation},</if>
            <if test="description != null and description != ''">description = #{description},</if>
            <if test="uavId != null">uav_id = #{uavId},</if>
            <if test="uavModel != null and uavModel != ''">uav_model = #{uavModel},</if>
            <if test="status != null">status = #{status},</if>
            update_time = sysdate()
        </set>
        where task_id = #{taskId}
    </update>
    
    <delete id="deleteUavTaskByTaskIds" parameterType="Long">
        delete from uav_task_info where task_id in 
        <foreach item="taskId" collection="array" open="(" separator="," close=")">
            #{taskId}
        </foreach>
    </delete>
</mapper>