<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.drone.system.mapper.RoleMenuMapper">
    <resultMap id="RoleMenuResult" type="RoleMenu">
        <result property="roleId" column="role_id" />
        <result property="menuId" column="menu_id" />
    </resultMap>

    <!-- 根据角色ID删除角色和菜单关联 -->
    <delete id="deleteRoleMenuByRoleId">
        delete from role_menu
        where role_id = #{roleId}
    </delete>

    <!-- 批量新增角色菜单信息 -->
    <insert id="batchRoleMenu">
        insert into role_menu(role_id, menu_id) values
        <foreach item="item" collection="list" separator="," index="index">
            (#{item.roleId},#{item.menuId})
        </foreach>
    </insert>

    <!-- 根据角色ID列表批量删除角色菜单关联 -->
    <delete id="deleteRoleMenuByRoleIds" parameterType="Long">
        delete from role_menu
        where role_id in
        <foreach collection="array" item="roleId"  separator="," open="(" close=")">
            #{roleId}
        </foreach>
    </delete>

</mapper>
